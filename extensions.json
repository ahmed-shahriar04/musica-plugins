      "author": "Musica Team",
      "icon": null,
      "config": {
        "lyricsSearchUrl": "https://api.lyrics.ovh/v1/{artist}/{title}",
        "lyricsResultPath": "",
        "syncedLyricsField": "",
        "plainLyricsField": "lyrics",
        "lyricsTrackNameField": "",
        "lyricsArtistNameField": ""
      }
    },
    {
      "id": "lrclib-direct",
      "name": "LRCLIB (Direct)",
      "type": "lyrics_provider",
      "version": "1.0.0",
      "description": "Synced + plain lyrics via LRCLIB exact-match API",
      "author": "Musica Team",
      "icon": null,
      "config": {
        "lyricsSearchUrl": "https://lrclib.net/api/get?track_name={title}&artist_name={artist}&duration={duration}",
        "lyricsResultPath": "",
        "syncedLyricsField": "syncedLyrics",
        "plainLyricsField": "plainLyrics",
        "lyricsTrackNameField": "",
        "lyricsArtistNameField": ""
      }
    },
    {
      "id": "lrclib-search",
      "name": "LRCLIB (Search)",
      "type": "lyrics_provider",
      "version": "1.0.0",
      "description": "Synced + plain lyrics via LRCLIB search API (fuzzy match)",
      "author": "Musica Team",
      "icon": null,
      "config": {
        "lyricsSearchUrl": "https://lrclib.net/api/search?q={title}%20{artist}",
        "lyricsResultPath": "0",
        "syncedLyricsField": "syncedLyrics",
        "plainLyricsField": "plainLyrics",
        "lyricsTrackNameField": "",
        "lyricsArtistNameField": ""
      }
    },
