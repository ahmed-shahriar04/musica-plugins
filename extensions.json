{
  "version": 1,
  "lastUpdated": "2026-09-21",
  "plugins": [
    {
      "id": "itunes",
      "name": "iTunes",
      "type": "json",
      "version": "1.0.0",
      "description": "Search music from Apple iTunes catalog",
      "author": "Musica Team",
      "icon": "https://upload.wikimedia.org/wikipedia/commons/thumb/d/d7/ITunes_logo.svg/512px-ITunes_logo.svg.png",
      "config": {
        "searchUrl": "https://itunes.apple.com/search?term={query}&media=music&limit=25",
        "resultPath": "results",
        "idField": "trackId",
        "titleField": "trackName",
        "artistField": "artistName",
        "thumbnailField": "artworkUrl100",
        "durationField": "trackTimeMillis",
        "streamField": "previewUrl",
        "chartsUrl": "https://itunes.apple.com/search?term=top+hits&media=music&limit=25"
      }
    },
    {
      "id": "deezer",
      "name": "Deezer",
      "type": "json",
      "version": "1.0.0",
      "description": "Search music from Deezer",
      "author": "Musica Team",
      "icon": "https://upload.wikimedia.org/wikipedia/commons/thumb/a/a2/Deezer_logo_2019.svg/512px-Deezer_logo_2019.svg.png",
      "config": {
        "searchUrl": "https://api.deezer.com/search?q={query}&limit=25",
        "resultPath": "data",
        "idField": "id",
        "titleField": "title",
        "artistField": "artist.name",
        "thumbnailField": "album.cover_medium",
        "durationField": "duration",
        "streamField": "preview",
        "chartsUrl": "https://api.deezer.com/chart/0/tracks?limit=25"
      }
    },
    {
      "id": "jamendo",
      "name": "Jamendo",
      "type": "json",
      "version": "1.0.0",
      "description": "Creative Commons music from Jamendo",
      "author": "Musica Team",
      "icon": "https://upload.wikimedia.org/wikipedia/commons/thumb/1/16/Jamendo_logo.svg/512px-Jamendo_logo.svg.png",
      "config": {
        "searchUrl": "https://api.jamendo.com/v3.0/tracks/?client_id=56d30c95&format=json&limit=25&search={query}",
        "resultPath": "results",
        "idField": "id",
        "titleField": "name",
        "artistField": "artist_name",
        "thumbnailField": "image",
        "durationField": "duration",
        "streamField": "audio",
        "chartsUrl": "https://api.jamendo.com/v3.0/tracks/?client_id=56d30c95&format=json&limit=25&order=popularity_total"
      }
    },

    {
      "id": "lyrics-ovh",
